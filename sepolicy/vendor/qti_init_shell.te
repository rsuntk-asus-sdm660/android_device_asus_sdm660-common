dontaudit qti_init_shell qti_init_shell:capability { dac_read_search };

# Allow handling directories (mkdir, rmdir, etc)
allow qti_init_shell configfs:dir create_dir_perms;

# Allow handling files (echo > file, etc)
allow qti_init_shell configfs:file create_file_perms;

# Allow creating symbolic links (ln -s)
allow qti_init_shell configfs:lnk_file create;

allow qti_init_shell proc_page_cluster:file w_file_perms;
allow qti_init_shell proc_sched:file rw_file_perms;
