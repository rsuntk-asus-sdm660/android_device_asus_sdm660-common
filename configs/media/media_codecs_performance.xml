<?xml version="1.0" encoding="utf-8" ?>
<!-- 
     ASUS X00TD/X01BD (SDM636/660) Media Performance
     Optimized for crDroid Android 13
-->
<MediaCodecs>
    <Encoders>
        <!-- AVC (H.264) Encoder -->
        <MediaCodec name="OMX.qcom.video.encoder.avc" type="video/avc" update="true">
            <Limit name="measured-frame-rate-320x240" range="300-300" />
            <Limit name="measured-frame-rate-720x480" range="120-120" />
            <Limit name="measured-frame-rate-1280x720" range="120-120" />
            <Limit name="measured-frame-rate-1920x1080" range="60-60" /> <!-- Boosted to 60fps for smooth 1080p rec -->
            <Limit name="measured-frame-rate-3840x2160" range="30-30" /> <!-- Added 4K support -->
        </MediaCodec>
        
        <!-- HEVC (H.265) Encoder -->
        <MediaCodec name="OMX.qcom.video.encoder.hevc" type="video/hevc" update="true">
            <Limit name="measured-frame-rate-320x240" range="300-300" />
            <Limit name="measured-frame-rate-720x480" range="120-120" />
            <Limit name="measured-frame-rate-1280x720" range="120-120" />
            <Limit name="measured-frame-rate-1920x1080" range="60-60" /> <!-- Boosted to 60fps -->
            <Limit name="measured-frame-rate-3840x2160" range="30-30" /> <!-- Fixed low FPS in original (was 13-26) -->
        </MediaCodec>
        
        <!-- H.263 Encoder -->
        <MediaCodec name="OMX.qcom.video.encoder.h263" type="video/3gpp" update="true">
            <Limit name="measured-frame-rate-176x144" range="300-300" />
            <Limit name="measured-frame-rate-352x288" range="260-260" />
        </MediaCodec>
        
        <!-- MPEG4 Encoder -->
        <MediaCodec name="OMX.qcom.video.encoder.mpeg4" type="video/mp4v-es" update="true">
            <Limit name="measured-frame-rate-176x144" range="300-300" />
            <Limit name="measured-frame-rate-352x288" range="260-260" />
            <Limit name="measured-frame-rate-640x480" range="144-144" />
        </MediaCodec>
    </Encoders>

    <Decoders>
        <!-- AVC (H.264) Decoder -->
        <MediaCodec name="OMX.qcom.video.decoder.avc" type="video/avc" update="true">
            <Limit name="measured-frame-rate-320x240" range="500-500" />
            <Limit name="measured-frame-rate-720x480" range="300-300" />
            <Limit name="measured-frame-rate-1280x720" range="200-200" />
            <Limit name="measured-frame-rate-1920x1080" range="120-120" /> <!-- Smooth 60fps playback -->
            <Limit name="measured-frame-rate-3840x2160" range="30-30" /> <!-- Added 4K playback support -->
        </MediaCodec>
        
        <!-- HEVC (H.265) Decoder -->
        <MediaCodec name="OMX.qcom.video.decoder.hevc" type="video/hevc" update="true">
            <Limit name="measured-frame-rate-352x288" range="600-600" />
            <Limit name="measured-frame-rate-640x360" range="400-400" />
            <Limit name="measured-frame-rate-720x480" range="300-300" />
            <Limit name="measured-frame-rate-1280x720" range="240-240" />
            <Limit name="measured-frame-rate-1920x1080" range="120-120" />
            <Limit name="measured-frame-rate-3840x2160" range="30-30" />
        </MediaCodec>
        
        <!-- H.263 Decoder -->
        <MediaCodec name="OMX.qcom.video.decoder.h263" type="video/3gpp" update="true">
            <Limit name="measured-frame-rate-176x144" range="800-800" />
            <Limit name="measured-frame-rate-352x288" range="800-800" />
        </MediaCodec>
        
        <!-- MPEG4 Decoder -->
        <MediaCodec name="OMX.qcom.video.decoder.mpeg4" type="video/mp4v-es" update="true">
            <Limit name="measured-frame-rate-176x144" range="800-800" />
            <Limit name="measured-frame-rate-480x360" range="700-700" />
            <Limit name="measured-frame-rate-1920x1080" range="60-60" />
        </MediaCodec>
        
        <!-- VP8 Decoder -->
        <MediaCodec name="OMX.qcom.video.decoder.vp8" type="video/x-vnd.on2.vp8" update="true">
            <Limit name="measured-frame-rate-320x180" range="500-500" />
            <Limit name="measured-frame-rate-640x360" range="400-400" />
            <Limit name="measured-frame-rate-1280x720" range="300-300" />
            <Limit name="measured-frame-rate-1920x1080" range="60-60" />
        </MediaCodec>
        
        <!-- VP9 Decoder -->
        <MediaCodec name="OMX.qcom.video.decoder.vp9" type="video/x-vnd.on2.vp9" update="true">
            <Limit name="measured-frame-rate-320x180" range="500-500" />
            <Limit name="measured-frame-rate-640x360" range="360-360" />
            <Limit name="measured-frame-rate-1280x720" range="200-200" />
            <Limit name="measured-frame-rate-1920x1080" range="120-120" />
            <Limit name="measured-frame-rate-3840x2160" range="30-30" /> <!-- Confirms HW VP9 decode for 4K YT -->
        </MediaCodec>
    </Decoders>
</MediaCodecs>
