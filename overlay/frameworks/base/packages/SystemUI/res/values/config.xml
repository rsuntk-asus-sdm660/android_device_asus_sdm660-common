<resources>

    <!-- Number of quick settings tiles -->
    <integer name="quick_qs_panel_max_tiles">6</integer>
    <integer name="quick_qs_panel_max_rows">2</integer>
    <integer name="quick_settings_num_columns">2</integer>
    <integer name="quick_settings_max_rows">4</integer>
    <integer name="quick_settings_min_num_tiles">6</integer>

    <!-- Enable or disable showing battery estimate in quick settings battery header -->
    <bool name="config_showBatteryEstimateQSBH">true</bool>

    <!-- Heads Up -->
    <integer name="heads_up_notification_decay">5000</integer>
    <integer name="auto_heads_up_notification_decay">3000</integer>
    <integer name="heads_up_default_snooze_length_ms">60000</integer>
    <integer name="heads_up_notification_minimum_time">2000</integer>
    <!-- Enable or disable heads up notification hiding header -->
    <bool name="heads_up_notification_hides_header">true</bool>
    <integer name="touch_acceptance_delay">700</integer>

    <!-- Maximum notification count on lock screen -->
    <integer name="keyguard_max_notification_count">4</integer>

    <!-- Smart Reply -->
    <!-- Enable or disable smart replies in notifications -->
    <bool name="config_smart_replies_in_notifications_enabled">true</bool>
    <!-- Enable or disable showing smart replies in heads up notifications -->
    <bool name="config_smart_replies_in_notifications_show_in_heads_up">true</bool>
    <integer name="config_smart_replies_in_notifications_max_num_actions">3</integer>

    <!-- Snooze timers -->
    <integer name="config_notification_snooze_time_default">60</integer>
    <integer-array name="config_notification_snooze_times">
        <item>15</item>
        <item>30</item>
        <item>60</item>
        <item>120</item>
    </integer-array>

    <!-- Enable doze mode -->
    <bool name="doze_display_state_supported">true</bool>
    <!-- Enable or disable doze suspend display state support -->
    <bool name="doze_suspend_display_state_supported">true</bool>

    <!-- Pulse on events -->
    <!-- Enable or disable doze pulse on significant motion -->
    <bool name="doze_pulse_on_significant_motion">true</bool>
    <!-- Enable or disable proximity check before doze pulse -->
    <bool name="doze_proximity_check_before_pulse">true</bool>
    <!-- Enable or disable proximity sensor usage for single tap doze -->
    <bool name="doze_single_tap_uses_prox">true</bool>
    <!-- Enable or disable proximity sensor usage for long press doze -->
    <bool name="doze_long_press_uses_prox">true</bool>

    <!-- Pulse timings for LCD -->
    <integer name="doze_pulse_duration_in">250</integer>
    <integer name="doze_pulse_duration_visible">3000</integer>
    <integer name="doze_pulse_duration_out">250</integer>
    <integer name="doze_small_icon_alpha">255</integer>

    <!-- False activation protection -->
    <integer name="doze_pickup_vibration_threshold">2000</integer>

    <!-- Volume Dialog -->
    <!-- Enable or disable volume UI -->
    <bool name="enable_volume_ui">true</bool>
    <!-- Enable or disable safety warning -->
    <bool name="enable_safety_warning">true</bool>
    <!-- Enable or disable showing low media volume icon -->
    <bool name="config_showLowMediaVolumeIcon">true</bool>
    <!-- Enable or disable changing volume row tint when inactive -->
    <bool name="config_changeVolumeRowTintWhenInactive">true</bool>
    <!-- Enable or disable volume dialog background blur -->
    <bool name="config_volumeDialogUseBackgroundBlur">false</bool>
    
    <integer name="config_dialogShowAnimationDurationMs">200</integer>
    <integer name="config_dialogHideAnimationDurationMs">150</integer>

    <!-- Power Menu -->
    <integer name="power_menu_lite_max_columns">2</integer>
    <integer name="power_menu_lite_max_rows">4</integer>

    <!-- Privacy Dots -->
    <!-- Enable or disable privacy dot -->
    <bool name="config_enablePrivacyDot">true</bool>

    <!-- Recents -->
    <string name="config_recentsComponent" translatable="false">com.android.systemui.recents.OverviewProxyRecentsImpl</string>

    <!-- Camera gesture vibration -->
    <integer-array translatable="false" name="config_cameraLaunchGestureVibePattern">
        <item>0</item>
        <item>40</item>
    </integer-array>

    <!-- Split shade (tablets only) -->
    <!-- Enable or disable split notification shade -->
    <bool name="config_use_split_notification_shade">false</bool>

    <!-- Navigation bar layout -->
    
    <!-- 3-button mode -->
    <string name="config_navBarLayout" translatable="false">left[.5W],back[1WC];home;recent[1WC],right[.5W]</string>
    
    <!-- 2-button mode (Quickstep) -->
    <string name="config_navBarLayoutQuickstep" translatable="false">back[1.7WC];home;menu_ime[1.7WC]</string>
    
    <!-- Gestural mode (handle only) -->
    <string name="config_navBarLayoutHandle" translatable="false">back[70AC];home_handle;ime_switcher[70AC]</string>

    <!-- Deadzone (accidental touch protection) -->
    <integer name="navigation_bar_deadzone_hold">333</integer>
    <integer name="navigation_bar_deadzone_decay">333</integer>
    <integer name="navigation_bar_deadzone_orientation">0</integer>
    <!-- Enable or disable dead zone flash -->
    <bool name="config_dead_zone_flash">false</bool>

    <!-- Auto-dimming navigation bar for OLED protection (disabled since device uses LCD) -->
    <!-- Enable or disable navigation bar auto dimming when no visible wallpaper -->
    <bool name="config_navigation_bar_enable_auto_dim_no_visible_wallpaper">false</bool>

    <!-- Rotation button position (left) -->
    <!-- Enable or disable floating rotation button position left -->
    <bool name="floating_rotation_button_position_left">true</bool>

    <!-- Do not show side fingerprint sensor hint on bouncer -->
    <!-- Enable or disable showing side fingerprint sensor hint on bouncer -->
    <bool name="config_show_sidefps_hint_on_bouncer">false</bool>

    <!-- UDFPS icon - empty (no under-display fingerprint scanner) -->
    <string name="config_udfpsIcon" translatable="false"></string>

    <!-- UDFPS progress bar radius - 0 (not used) -->
    <integer name="config_udfpsEnrollProgressBar" translatable="false">0</integer>

    <!-- Lock icon long press duration -->
    <integer name="config_lockIconLongPress" translatable="false">200</integer>

    <!-- Face Unlock bypass behavior:
         0 = Do not override (use settings)
         1 = Always bypass keyguard
         2 = Never bypass -->
    <integer name="config_face_unlock_bypass_override">0</integer>

    <!-- Fingerprint assistance messages when Face Unlock is enrolled -->
    <integer-array name="config_face_help_msgs_when_fingerprint_enrolled">
        <item>3</item>  <!-- TOO_DARK -->
        <item>25</item> <!-- DARK_GLASSES -->
        <item>26</item> <!-- MOUTH_COVERING -->
    </integer-array>
    
    <!-- Empty - no dedicated camera for Face Unlock -->
    <integer-array name="config_face_auth_props">
        <!-- sensorLocationX -->
        <!-- sensorLocationY -->
        <!-- sensorRadius -->
    </integer-array>
    
</resources>
