#============= hal_perf_default ==============

# Связываем с атрибутом (если используешь override, иначе убери)
typeattribute hal_perf_default hal_perf_override;

# Разрешаем запуск сервиса (если нет в common политиках)
init_daemon_domain(hal_perf_default)

# --- Binder & HIDL ---
# Включаем binder для HAL
hwbinder_use(hal_perf_default)
get_prop(hal_perf_default, hwservicemanager_prop)

# Разрешаем регистрироваться как perf HAL
add_hwservice(hal_perf_default, hal_perf_hwservice)
allow hal_perf_default hidl_base_hwservice:hwservice_manager add;

# Взаимодействие с другими процессами (PowerHAL, SystemServer, Shell, Graphics)
binder_call(hal_perf_default, hal_power_default)
binder_call(hal_perf_default, system_server)
binder_call(hal_perf_default, hal_graphics_composer_default)
binder_call(hal_perf_default, servicemanager)
binder_call(hal_perf_default, shell) # Для отладки (lshal)

# Разрешаем другим искать нас
allow hal_power_default hal_perf_hwservice:hwservice_manager find;
allow shell hal_perf_hwservice:hwservice_manager find; # Для отладки

# --- Files & Sockets ---
# Конфиги и данные (/data/vendor/perfd)
allow hal_perf_default vendor_configs_file:file r_file_perms;
allow hal_perf_default vendor_data_file:dir create_dir_perms;
allow hal_perf_default vendor_data_file:file create_file_perms;

# Socket (если используется)
allow hal_perf_default init:unix_stream_socket connectto;
allow hal_perf_default property_socket:sock_file write;
allow hal_perf_default mpctl_data_file:dir create_dir_perms;
allow hal_perf_default mpctl_data_file:file create_file_perms;

# --- Hardware Tuning ---
# CPU / Scheduler
allow hal_perf_default proc_sched_boost:file rw_file_perms;
# Sched boost
allow hal_perf_default proc_sched:file { open read write getattr };
allow hal_perf_default sysfs_devices_system_cpu:dir r_dir_perms;
allow hal_perf_default sysfs_devices_system_cpu:file rw_file_perms;
allow hal_perf_default self:capability { dac_override dac_read_search };

# Cgroups
allow hal_perf_default cgroup:file rw_file_perms;
allow hal_perf_default cgroup:dir r_dir_perms;
allow hal_perf_default cgroup_v2:file rw_file_perms;
allow hal_perf_default cgroup_v2:dir r_dir_perms;

# GPU (Devfreq / KGSL)
allow hal_perf_default sysfs_devfreq:dir r_dir_perms;
allow hal_perf_default sysfs_devfreq:file rw_file_perms;
allow hal_perf_default sysfs_devfreq:lnk_file read;
allow hal_perf_default sysfs_kgsl:file rw_file_perms;
allow hal_perf_default sysfs_kgsl:dir r_dir_perms;
allow hal_perf_default sysfs_kgsl:lnk_file r_file_perms;

# Properties
set_prop(hal_perf_default, vendor_mpctl_prop);

# Разрешаем взаимодействие с PowerHAL
allow hal_perf_default hal_power_default:binder { call transfer };

# Разрешаем взаимодействие с Shell (для lshal)
allow hal_perf_default shell:binder transfer;

# Разрешаем взаимодействие с System Server (для PerfService)
allow hal_perf_default system_server:binder transfer;

# Разрешаем доступ к HWService Manager
allow hal_perf_default hal_perf_hwservice:hwservice_manager { add find };

# Socket creation
allow hal_perf_default hal_power_default:unix_stream_socket { read write getattr accept };
allow hal_perf_default mpctl_socket:sock_file { create write unlink setattr };
allow hal_perf_default mpctl_socket:dir { add_name remove_name write search };

# Для работы с классом hal
allow hal_perf_default hal_perf_default:unix_stream_socket { listen accept };

# Если proc_sched не определён, используйте:
allow hal_perf_default proc:file { open read write getattr };

set_prop(hal_perf_default, vendor_perf_prop)
get_prop(hal_perf_default, vendor_perf_prop)
