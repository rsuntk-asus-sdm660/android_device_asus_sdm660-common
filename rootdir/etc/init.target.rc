on early-init
    mount debugfs debugfs /sys/kernel/debug
    chmod 0755 /sys/kernel/debug
    wait /dev/msm-rng 2
    # hw_random создаётся системой, symlink/chmod/chown не нужны
    # symlink /dev/msm-rng /dev/hw_random
    # chmod 0644 /dev/hw_random
    # chown root root /dev/hw_random
    write /sys/module/msm_thermal/parameters/enabled N

on init
    # Schedtune baseline (умеренный)
    write /dev/stune/foreground/schedtune.sched_boost_no_override 1
    write /dev/stune/top-app/schedtune.sched_boost_no_override 1
    write /dev/stune/schedtune.colocate 0
    write /dev/stune/background/schedtune.colocate 0
    write /dev/stune/system-background/schedtune.colocate 0
    write /dev/stune/foreground/schedtune.colocate 0
    write /dev/stune/top-app/schedtune.colocate 1

    # ★ ИЗМЕНЕНО: Умеренный начальный boost
    write /dev/stune/top-app/schedtune.boost 5

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    start hwservicemanager
    mount_all --early
    mount tmpfs tmpfs /metadata size=10m

    chown root system /mnt/vendor/persist
    chmod 0771 /mnt/vendor/persist
    restorecon_recursive /mnt/vendor/persist
    mkdir /mnt/vendor/persist/data 0700 system system
    mkdir /mnt/vendor/persist/bms 0700 root system
    write /sys/kernel/boot_adsp/boot 1

    chown system system /sys/devices/platform/soc/a800000.ssusb/mode

    mkdir /mnt/vendor/dsp 0770 root root
    copy /vendor/dsp/cdsp/fastrpc_shell_3 /mnt/vendor/dsp/fastrpc_shell_3
    chmod 0644 /mnt/vendor/dsp/fastrpc_shell_3
    mount none /mnt/vendor/dsp/fastrpc_shell_3 /vendor/dsp/cdsp/fastrpc_shell_3 bind

on late-fs
    mount_all --late

on post-fs
    write /dev/ipa 1
    start vendor.qseecomd
    wait_for_prop vendor.sys.listeners.registered true

on early-boot
    chown system system /mnt/vendor/persist/sensors
    chown system system /mnt/vendor/persist/sensors/sns.reg
    chown system system /mnt/vendor/persist/sensors/sensors_settings
    chmod 0664 /mnt/vendor/persist/sensors/sensors_settings

on post-fs-data
    mkdir /data/vendor/nfc 0770 nfc nfc

on boot
    start vendor.rmt_storage

    setprop persist.camera.gyro.disable 0
    mkdir /data/vendor/camera 0770 camera camera

    chown wifi wifi /sys/module/wlan/parameters/fwpath

    setprop vendor.usb.rndis.func.name "rndis_bam"
    setprop vendor.usb.rmnet.func.name "rmnet_bam"
    setprop vendor.usb.rmnet.inst.name "rmnet"
    setprop vendor.usb.dpl.inst.name "dpl"
    setprop vendor.usb.qdss.inst.name "qdss"

service vendor.per_mgr /vendor/bin/pm-service
    class core
    user system
    group system
    ioprio rt 4

service vendor.per_proxy /vendor/bin/pm-proxy
    class core
    user system
    group system
    disabled

on property:init.svc.vendor.per_mgr=running
    start vendor.per_proxy

on property:sys.shutdown.requested=*
    stop vendor.per_proxy

service vendor.qseecomd /vendor/bin/qseecomd
    class core
    user root
    group root

service vendor-sensor-sh /vendor/bin/init.qcom.sensors.sh
    class core
    user root
    oneshot

service vendor.sensors.qti /vendor/bin/sensors.qti
    class core
    user system
    group system
    disabled

service vendor.pd_mapper /vendor/bin/pd-mapper
    class core

on property:vold.decrypt=trigger_restart_framework
    restart vendor.camera.provider

service dcvs-sh /vendor/bin/init.qti.dcvs.sh
    class late_start
    user root
    group root system
    disabled
    oneshot

on property:vendor.dcvs.prop=1
    start dcvs-sh

# ═══════════════════════════════════════════════════════════════════════════
# Boot completed — thermal caps HAL handles performance, not this script
# ═══════════════════════════════════════════════════════════════════════════
on property:sys.boot_completed=1
    # ★ ИЗМЕНЕНО: Не сбрасываем boost — thermal HAL управляет caps
    # Только логируем завершение загрузки
    write /dev/kmsg "Boot completed - thermal caps active"
