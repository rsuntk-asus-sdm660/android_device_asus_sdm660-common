on boot
    # ========== GPU DEVFREQ ==========
    chown system system /sys/class/kgsl/kgsl-3d0/devfreq/min_freq
    chown system system /sys/class/kgsl/kgsl-3d0/devfreq/max_freq
    chown system system /sys/class/kgsl/kgsl-3d0/devfreq/governor
    chmod 0664 /sys/class/kgsl/kgsl-3d0/devfreq/min_freq
    chmod 0664 /sys/class/kgsl/kgsl-3d0/devfreq/max_freq
    chmod 0664 /sys/class/kgsl/kgsl-3d0/devfreq/governor

    # ========== GPU POWER LEVELS ==========
    chown system system /sys/class/kgsl/kgsl-3d0/min_pwrlevel
    chown system system /sys/class/kgsl/kgsl-3d0/max_pwrlevel
    chown system system /sys/class/kgsl/kgsl-3d0/default_pwrlevel
    chown system system /sys/class/kgsl/kgsl-3d0/thermal_pwrlevel
    chmod 0664 /sys/class/kgsl/kgsl-3d0/min_pwrlevel
    chmod 0664 /sys/class/kgsl/kgsl-3d0/max_pwrlevel
    chmod 0664 /sys/class/kgsl/kgsl-3d0/default_pwrlevel
    chmod 0664 /sys/class/kgsl/kgsl-3d0/thermal_pwrlevel

    # ========== DEVFREQ BW ==========
    chown system system /sys/class/devfreq/soc:qcom,gpubw/min_freq
    chown system system /sys/class/devfreq/soc:qcom,gpubw/max_freq
    chown system system /sys/class/devfreq/soc:qcom,cpu-cpu-ddr-bw/min_freq
    chown system system /sys/class/devfreq/soc:qcom,cpu-cpu-ddr-bw/max_freq
    chmod 0664 /sys/class/devfreq/soc:qcom,gpubw/min_freq
    chmod 0664 /sys/class/devfreq/soc:qcom,gpubw/max_freq
    chmod 0664 /sys/class/devfreq/soc:qcom,cpu-cpu-ddr-bw/min_freq
    chmod 0664 /sys/class/devfreq/soc:qcom,cpu-cpu-ddr-bw/max_freq

    # ========== DDR LATENCY ==========
    chown system system /sys/class/devfreq/soc:qcom,cpu0-cpu-ddr-lat/min_freq
    chown system system /sys/class/devfreq/soc:qcom,cpu0-cpu-ddr-lat/max_freq
    chown system system /sys/class/devfreq/soc:qcom,cpu0-cpu-ddr-latfloor/min_freq
    chown system system /sys/class/devfreq/soc:qcom,cpu0-cpu-ddr-latfloor/max_freq
    chown system system /sys/class/devfreq/soc:qcom,cpu4-cpu-ddr-lat/min_freq
    chown system system /sys/class/devfreq/soc:qcom,cpu4-cpu-ddr-lat/max_freq
    chown system system /sys/class/devfreq/soc:qcom,cpu4-cpu-ddr-latfloor/min_freq
    chown system system /sys/class/devfreq/soc:qcom,cpu4-cpu-ddr-latfloor/max_freq
    chmod 0664 /sys/class/devfreq/soc:qcom,cpu0-cpu-ddr-lat/min_freq
    chmod 0664 /sys/class/devfreq/soc:qcom,cpu0-cpu-ddr-lat/max_freq
    chmod 0664 /sys/class/devfreq/soc:qcom,cpu0-cpu-ddr-latfloor/min_freq
    chmod 0664 /sys/class/devfreq/soc:qcom,cpu0-cpu-ddr-latfloor/max_freq
    chmod 0664 /sys/class/devfreq/soc:qcom,cpu4-cpu-ddr-lat/min_freq
    chmod 0664 /sys/class/devfreq/soc:qcom,cpu4-cpu-ddr-lat/max_freq
    chmod 0664 /sys/class/devfreq/soc:qcom,cpu4-cpu-ddr-latfloor/min_freq
    chmod 0664 /sys/class/devfreq/soc:qcom,cpu4-cpu-ddr-latfloor/max_freq

    # ========== CORE CTL ==========
    chown system system /sys/devices/system/cpu/cpu0/core_ctl/min_cpus
    chown system system /sys/devices/system/cpu/cpu0/core_ctl/max_cpus
    chown system system /sys/devices/system/cpu/cpu0/core_ctl/enable
    chown system system /sys/devices/system/cpu/cpu4/core_ctl/min_cpus
    chown system system /sys/devices/system/cpu/cpu4/core_ctl/max_cpus
    chown system system /sys/devices/system/cpu/cpu4/core_ctl/enable
    chmod 0664 /sys/devices/system/cpu/cpu0/core_ctl/min_cpus
    chmod 0664 /sys/devices/system/cpu/cpu0/core_ctl/max_cpus
    chmod 0664 /sys/devices/system/cpu/cpu0/core_ctl/enable
    chmod 0664 /sys/devices/system/cpu/cpu4/core_ctl/min_cpus
    chmod 0664 /sys/devices/system/cpu/cpu4/core_ctl/max_cpus
    chmod 0664 /sys/devices/system/cpu/cpu4/core_ctl/enable

    # ========== COOLING DEVICES ==========
    chown system system /sys/class/thermal/cooling_device0/cur_state
    chown system system /sys/class/thermal/cooling_device1/cur_state
    chown system system /sys/class/thermal/cooling_device2/cur_state
    chown system system /sys/class/thermal/cooling_device3/cur_state
    chown system system /sys/class/thermal/cooling_device4/cur_state
    chmod 0664 /sys/class/thermal/cooling_device0/cur_state
    chmod 0664 /sys/class/thermal/cooling_device1/cur_state
    chmod 0664 /sys/class/thermal/cooling_device2/cur_state
    chmod 0664 /sys/class/thermal/cooling_device3/cur_state
    chmod 0664 /sys/class/thermal/cooling_device4/cur_state

    # ========== THERMAL ZONES MODE ==========
    chown system system /sys/class/thermal/thermal_zone0/mode
    chown system system /sys/class/thermal/thermal_zone1/mode
    chown system system /sys/class/thermal/thermal_zone2/mode
    chown system system /sys/class/thermal/thermal_zone3/mode
    chown system system /sys/class/thermal/thermal_zone4/mode
    chown system system /sys/class/thermal/thermal_zone5/mode
    chown system system /sys/class/thermal/thermal_zone6/mode
    chown system system /sys/class/thermal/thermal_zone7/mode
    chown system system /sys/class/thermal/thermal_zone8/mode
    chown system system /sys/class/thermal/thermal_zone9/mode
    chmod 0664 /sys/class/thermal/thermal_zone0/mode
    chmod 0664 /sys/class/thermal/thermal_zone1/mode
    chmod 0664 /sys/class/thermal/thermal_zone2/mode
    chmod 0664 /sys/class/thermal/thermal_zone3/mode
    chmod 0664 /sys/class/thermal/thermal_zone4/mode
    chmod 0664 /sys/class/thermal/thermal_zone5/mode
    chmod 0664 /sys/class/thermal/thermal_zone6/mode
    chmod 0664 /sys/class/thermal/thermal_zone7/mode
    chmod 0664 /sys/class/thermal/thermal_zone8/mode
    chmod 0664 /sys/class/thermal/thermal_zone9/mode

    # ========== CPU IDLE ==========
    chown system system /sys/devices/system/cpu/cpu0/cpuidle/state0/disable
    chown system system /sys/devices/system/cpu/cpu0/cpuidle/state1/disable
    chown system system /sys/devices/system/cpu/cpu0/cpuidle/state2/disable
    chown system system /sys/devices/system/cpu/cpu1/cpuidle/state0/disable
    chown system system /sys/devices/system/cpu/cpu1/cpuidle/state1/disable
    chown system system /sys/devices/system/cpu/cpu1/cpuidle/state2/disable
    chown system system /sys/devices/system/cpu/cpu2/cpuidle/state0/disable
    chown system system /sys/devices/system/cpu/cpu2/cpuidle/state1/disable
    chown system system /sys/devices/system/cpu/cpu2/cpuidle/state2/disable
    chown system system /sys/devices/system/cpu/cpu3/cpuidle/state0/disable
    chown system system /sys/devices/system/cpu/cpu3/cpuidle/state1/disable
    chown system system /sys/devices/system/cpu/cpu3/cpuidle/state2/disable
    chown system system /sys/devices/system/cpu/cpu4/cpuidle/state0/disable
    chown system system /sys/devices/system/cpu/cpu4/cpuidle/state1/disable
    chown system system /sys/devices/system/cpu/cpu4/cpuidle/state2/disable
    chown system system /sys/devices/system/cpu/cpu5/cpuidle/state0/disable
    chown system system /sys/devices/system/cpu/cpu5/cpuidle/state1/disable
    chown system system /sys/devices/system/cpu/cpu5/cpuidle/state2/disable
    chown system system /sys/devices/system/cpu/cpu6/cpuidle/state0/disable
    chown system system /sys/devices/system/cpu/cpu6/cpuidle/state1/disable
    chown system system /sys/devices/system/cpu/cpu6/cpuidle/state2/disable
    chown system system /sys/devices/system/cpu/cpu7/cpuidle/state0/disable
    chown system system /sys/devices/system/cpu/cpu7/cpuidle/state1/disable
    chown system system /sys/devices/system/cpu/cpu7/cpuidle/state2/disable
    chmod 0664 /sys/devices/system/cpu/cpu0/cpuidle/state0/disable
    chmod 0664 /sys/devices/system/cpu/cpu0/cpuidle/state1/disable
    chmod 0664 /sys/devices/system/cpu/cpu0/cpuidle/state2/disable
    chmod 0664 /sys/devices/system/cpu/cpu1/cpuidle/state0/disable
    chmod 0664 /sys/devices/system/cpu/cpu1/cpuidle/state1/disable
    chmod 0664 /sys/devices/system/cpu/cpu1/cpuidle/state2/disable
    chmod 0664 /sys/devices/system/cpu/cpu2/cpuidle/state0/disable
    chmod 0664 /sys/devices/system/cpu/cpu2/cpuidle/state1/disable
    chmod 0664 /sys/devices/system/cpu/cpu2/cpuidle/state2/disable
    chmod 0664 /sys/devices/system/cpu/cpu3/cpuidle/state0/disable
    chmod 0664 /sys/devices/system/cpu/cpu3/cpuidle/state1/disable
    chmod 0664 /sys/devices/system/cpu/cpu3/cpuidle/state2/disable
    chmod 0664 /sys/devices/system/cpu/cpu4/cpuidle/state0/disable
    chmod 0664 /sys/devices/system/cpu/cpu4/cpuidle/state1/disable
    chmod 0664 /sys/devices/system/cpu/cpu4/cpuidle/state2/disable
    chmod 0664 /sys/devices/system/cpu/cpu5/cpuidle/state0/disable
    chmod 0664 /sys/devices/system/cpu/cpu5/cpuidle/state1/disable
    chmod 0664 /sys/devices/system/cpu/cpu5/cpuidle/state2/disable
    chmod 0664 /sys/devices/system/cpu/cpu6/cpuidle/state0/disable
    chmod 0664 /sys/devices/system/cpu/cpu6/cpuidle/state1/disable
    chmod 0664 /sys/devices/system/cpu/cpu6/cpuidle/state2/disable
    chmod 0664 /sys/devices/system/cpu/cpu7/cpuidle/state0/disable
    chmod 0664 /sys/devices/system/cpu/cpu7/cpuidle/state1/disable
    chmod 0664 /sys/devices/system/cpu/cpu7/cpuidle/state2/disable

    # ========== GPU EXTRA ==========
    chown system system /sys/class/kgsl/kgsl-3d0/force_rail_on
    chown system system /sys/class/kgsl/kgsl-3d0/force_clk_on
    chown system system /sys/class/kgsl/kgsl-3d0/idle_timer
    chown system system /sys/class/kgsl/kgsl-3d0/force_no_nap
    chmod 0664 /sys/class/kgsl/kgsl-3d0/force_rail_on
    chmod 0664 /sys/class/kgsl/kgsl-3d0/force_clk_on
    chmod 0664 /sys/class/kgsl/kgsl-3d0/idle_timer
    chmod 0664 /sys/class/kgsl/kgsl-3d0/force_no_nap

    # ========== CPU IDLE LATENCY ==========
    chown system system /sys/devices/system/cpu/cpu0/cpuidle/state0/latency
    chown system system /sys/devices/system/cpu/cpu1/cpuidle/state0/latency
    chown system system /sys/devices/system/cpu/cpu2/cpuidle/state0/latency
    chown system system /sys/devices/system/cpu/cpu3/cpuidle/state0/latency
    chown system system /sys/devices/system/cpu/cpu4/cpuidle/state0/latency
    chown system system /sys/devices/system/cpu/cpu5/cpuidle/state0/latency
    chown system system /sys/devices/system/cpu/cpu6/cpuidle/state0/latency
    chown system system /sys/devices/system/cpu/cpu7/cpuidle/state0/latency
    chmod 0664 /sys/devices/system/cpu/cpu0/cpuidle/state0/latency
    chmod 0664 /sys/devices/system/cpu/cpu1/cpuidle/state0/latency
    chmod 0664 /sys/devices/system/cpu/cpu2/cpuidle/state0/latency
    chmod 0664 /sys/devices/system/cpu/cpu3/cpuidle/state0/latency
    chmod 0664 /sys/devices/system/cpu/cpu4/cpuidle/state0/latency
    chmod 0664 /sys/devices/system/cpu/cpu5/cpuidle/state0/latency
    chmod 0664 /sys/devices/system/cpu/cpu6/cpuidle/state0/latency
    chmod 0664 /sys/devices/system/cpu/cpu7/cpuidle/state0/latency
    
    # CPU Boost
    chown system system /sys/devices/system/cpu/cpu_boost/input_boost_freq
    chmod 0664 /sys/devices/system/cpu/cpu_boost/input_boost_freq
    chown system system /sys/devices/system/cpu/cpu_boost/input_boost_ms
    chmod 0664 /sys/devices/system/cpu/cpu_boost/input_boost_ms

    # ========== CPU SCHEDUTIL ==========
    chown system system /sys/devices/system/cpu/cpu0/cpufreq/schedutil/hispeed_freq
    chown system system /sys/devices/system/cpu/cpu0/cpufreq/schedutil/hispeed_load
    chown system system /sys/devices/system/cpu/cpu0/cpufreq/schedutil/pl
    chown system system /sys/devices/system/cpu/cpu0/cpufreq/schedutil/rtg_boost_freq
    chown system system /sys/devices/system/cpu/cpu0/cpufreq/schedutil/down_rate_limit_us
    chown system system /sys/devices/system/cpu/cpu0/cpufreq/schedutil/up_rate_limit_us
    chmod 0664 /sys/devices/system/cpu/cpu0/cpufreq/schedutil/hispeed_freq
    chmod 0664 /sys/devices/system/cpu/cpu0/cpufreq/schedutil/hispeed_load
    chmod 0664 /sys/devices/system/cpu/cpu0/cpufreq/schedutil/pl
    chmod 0664 /sys/devices/system/cpu/cpu0/cpufreq/schedutil/rtg_boost_freq
    chmod 0664 /sys/devices/system/cpu/cpu0/cpufreq/schedutil/down_rate_limit_us
    chmod 0664 /sys/devices/system/cpu/cpu0/cpufreq/schedutil/up_rate_limit_us

    chown system system /sys/devices/system/cpu/cpu4/cpufreq/schedutil/hispeed_freq
    chown system system /sys/devices/system/cpu/cpu4/cpufreq/schedutil/hispeed_load
    chown system system /sys/devices/system/cpu/cpu4/cpufreq/schedutil/pl
    chown system system /sys/devices/system/cpu/cpu4/cpufreq/schedutil/rtg_boost_freq
    chown system system /sys/devices/system/cpu/cpu4/cpufreq/schedutil/down_rate_limit_us
    chown system system /sys/devices/system/cpu/cpu4/cpufreq/schedutil/up_rate_limit_us
    chmod 0664 /sys/devices/system/cpu/cpu4/cpufreq/schedutil/hispeed_freq
    chmod 0664 /sys/devices/system/cpu/cpu4/cpufreq/schedutil/hispeed_load
    chmod 0664 /sys/devices/system/cpu/cpu4/cpufreq/schedutil/pl
    chmod 0664 /sys/devices/system/cpu/cpu4/cpufreq/schedutil/rtg_boost_freq
    chmod 0664 /sys/devices/system/cpu/cpu4/cpufreq/schedutil/down_rate_limit_us
    chmod 0664 /sys/devices/system/cpu/cpu4/cpufreq/schedutil/up_rate_limit_us

    # ========== SCHED LOAD BOOST ==========
    chown system system /sys/devices/system/cpu/cpu0/sched_load_boost
    chown system system /sys/devices/system/cpu/cpu1/sched_load_boost
    chown system system /sys/devices/system/cpu/cpu2/sched_load_boost
    chown system system /sys/devices/system/cpu/cpu3/sched_load_boost
    chown system system /sys/devices/system/cpu/cpu4/sched_load_boost
    chown system system /sys/devices/system/cpu/cpu5/sched_load_boost
    chown system system /sys/devices/system/cpu/cpu6/sched_load_boost
    chown system system /sys/devices/system/cpu/cpu7/sched_load_boost
    chmod 0664 /sys/devices/system/cpu/cpu0/sched_load_boost
    chmod 0664 /sys/devices/system/cpu/cpu1/sched_load_boost
    chmod 0664 /sys/devices/system/cpu/cpu2/sched_load_boost
    chmod 0664 /sys/devices/system/cpu/cpu3/sched_load_boost
    chmod 0664 /sys/devices/system/cpu/cpu4/sched_load_boost
    chmod 0664 /sys/devices/system/cpu/cpu5/sched_load_boost
    chmod 0664 /sys/devices/system/cpu/cpu6/sched_load_boost
    chmod 0664 /sys/devices/system/cpu/cpu7/sched_load_boost
