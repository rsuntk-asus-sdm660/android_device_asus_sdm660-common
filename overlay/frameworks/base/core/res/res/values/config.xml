    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 2: POWER, SLEEP AND NOTIFICATIONS

         NOTIFICATION DELIVERY STRATEGY:
         The previous config had AutoPowerModes=true which caused
         aggressive idle batching — notifications arrived only when
         the user manually woke the device. Additionally,
         suspendWhenScreenOffDueToProximity=true caused full suspend
         when proximity sensor was covered (pocket), blocking all
         push delivery until a hardware IRQ woke the SoC.

         This version fixes all of these issues:
         - AutoPowerModes disabled
         - Doze pulse on notification enabled
         - CPU interactive mode decoupled from display
         - Proximity-based suspend disabled
         ═══════════════════════════════════════════════════════════════ -->

    <!-- AutoPowerModes DISABLED
         With these enabled, the system enters deep idle aggressively
         using the motion sensor, batching all sync/push/jobs until
         the next maintenance window (up to 15+ minutes).
         Disabling costs ~3-5% battery per day but ensures timely
         notification delivery. This is the right tradeoff for devices
         without AOD where users depend on pulse/LED/sound. -->
    <bool name="config_enableAutoPowerModes">false</bool>
    <bool name="config_autoPowerModeUseMotionSensor">false</bool>
    <bool name="config_autoPowerModePrefetchLocation">false</bool>

    <!-- Wake screen when unplugging charger -->
    <bool name="config_unplugTurnsOnScreen">true</bool>

    <!-- Doze configuration
         config_dozeAfterScreenOffByDefault = true
           Enables ambient/pulse state after screen off.
           When a notification arrives, DozeService can briefly
           illuminate the screen (pulse) to show the notification.

         config_dozeAlwaysOnDisplayAvailable = false
         config_dozeAlwaysOnEnabled = false
           AOD on IPS LCD wastes significant power since the entire
           backlight must stay on. Disabled on both devices.

         config_dozePulsePickup = true
         config_dozePickupGestureEnabled = true
           Lifting the phone triggers a pulse showing notifications.
           Both devices have accelerometers that support this.

         Result: notifications trigger a brief screen wake (pulse),
         LED blinks, sound/vibration plays — user sees notification
         without pressing power button. -->
    <string name="config_dozeComponent" translatable="false">com.android.systemui/com.android.systemui.doze.DozeService</string>
    <bool name="config_dozeEnabled">true</bool>
    <bool name="config_dozeAfterScreenOffByDefault">true</bool>
    <bool name="config_dozeAlwaysOnDisplayAvailable">false</bool>
    <bool name="config_dozeAlwaysOnEnabled">false</bool>
    <bool name="config_displayBlanksAfterDoze">false</bool>
    <bool name="config_displayBrightnessBucketsInDoze">false</bool>
    <bool name="config_dozePulsePickup">true</bool>
    <bool name="config_dozePickupGestureEnabled">true</bool>

    <!-- Dreaming (screensaver) -->
    <bool name="config_dreamsSupported">true</bool>
    <bool name="config_dreamsEnabledByDefault">false</bool>
    <bool name="config_dreamsActivatedOnDockByDefault">true</bool>
    <bool name="config_dreamsActivatedOnSleepByDefault">false</bool>
    <bool name="config_dreamsEnabledOnBattery">false</bool>
    <integer name="config_dreamsBatteryLevelMinimumWhenNotPowered">20</integer>
    <integer name="config_dreamsBatteryLevelDrainCutoff">5</integer>

    <!-- Power mode decoupling
         InteractiveMode decoupled from display = true
         Allows CPU to remain in interactive governor mode when screen
         is off. Critical for timely push notification processing.
         On SDM636/660 with schedutil/interactive governor, this means
         the CPU doesn't drop to powersave at screen-off and can
         quickly handle incoming GCM/FCM wakeups.

         AutoSuspend remains coupled (false) — the system controls
         suspend entry, but interactive mode is independent of display. -->
    <bool name="config_powerDecoupleAutoSuspendModeFromDisplay">false</bool>
    <bool name="config_powerDecoupleInteractiveModeFromDisplay">true</bool>

    <!-- Proximity-based suspend DISABLED
         Was true — forced full SoC suspend when proximity sensor
         was covered (phone in pocket/face-down). In full suspend,
         no push notifications are processed until a hardware IRQ.
         On X00TD/X01BD the proximity sensor sometimes "sticks" due
         to poor calibration, causing hours without notifications.
         With false — screen stays off but CPU can process pushes. -->
    <bool name="config_suspendWhenScreenOffDueToProximity">false</bool>

    <!-- Screen timeouts -->
    <integer name="config_minimumScreenOffTimeout">10000</integer>
    <integer name="config_maximumScreenDimDuration">7000</integer>
    <fraction name="config_maximumScreenDimRatio">20%</fraction>

    <!-- Battery warning levels -->
    <integer name="config_criticalBatteryWarningLevel">5</integer>
