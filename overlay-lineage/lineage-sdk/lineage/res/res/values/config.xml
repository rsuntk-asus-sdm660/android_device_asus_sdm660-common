<?xml version="1.0" encoding="utf-8"?>
<!--
    ╔══════════════════════════════════════════════════════════════╗
    ║  LINEAGE SDK CONFIG — ASUS X00TD / X01BD                     ║
    ║  Hardware features и расширенные функции                     ║
    ╚══════════════════════════════════════════════════════════════╝
-->
<resources>

    <!-- ╔══════════════════════════════════════════════════════════╗
         ║  PROXIMITY SENSOR                                        ║
         ╚══════════════════════════════════════════════════════════╝ -->

    <!-- Проверка датчика приближения при пробуждении -->
    <bool name="config_proximityCheckOnWake">true</bool>
    <integer name="config_proximityCheckTimeout">100</integer>
    <bool name="config_proximityCheckOnWakeEnabledByDefault">true</bool>


    <!-- ╔══════════════════════════════════════════════════════════╗
         ║  DOUBLE TAP TO SLEEP (Статусбар)                         ║
         ╚══════════════════════════════════════════════════════════╝ -->

    <bool name="config_dt2sGestureAvailable">true</bool>
    <bool name="config_dt2sGestureEnabledByDefault">true</bool>


    <!-- ╔══════════════════════════════════════════════════════════╗
         ║  LIVEDISPLAY (Цветокалибровка)                           ║
         ╚══════════════════════════════════════════════════════════╝ -->

    <bool name="config_enableLiveDisplay">true</bool>
    
    <!-- Температуры -->
    <integer name="config_dayColorTemperature">6500</integer>
    <integer name="config_nightColorTemperature">4800</integer>
    <integer name="config_minColorTemperature">1000</integer>
    <integer name="config_maxColorTemperature">10000</integer>
    
    <!-- Outdoor mode -->
    <integer name="config_outdoorAmbientLux">12000</integer>
    <integer name="config_outdoorAmbientLuxHysteresis">1500</integer>
    
    <!-- Улучшения дисплея -->
    <bool name="config_defaultAutoContrast">true</bool>
    <bool name="config_defaultAutoOutdoorMode">true</bool>
    <bool name="config_defaultColorEnhancement">true</bool>
    <bool name="config_defaultCABC">true</bool>
    <bool name="config_defaultAntiFlicker">false</bool>


    <!-- ╔══════════════════════════════════════════════════════════╗
         ║  LED УВЕДОМЛЕНИЙ                                         ║
         ╚══════════════════════════════════════════════════════════╝ -->

    <!-- LED capabilities (bitfield):
         
         1   = LIGHTS_RGB_NOTIFICATION_LED (RGB notifications)
         2   = LIGHTS_RGB_BATTERY_LED (RGB battery)
         8   = LIGHTS_PULSATING_LED (pulsing)
         32  = LIGHTS_ADJUSTABLE_NOTIFICATION_LED_BRIGHTNESS (adjustable brightness)
         64  = LIGHTS_BATTERY_LED (battery LED)
         128 = LIGHTS_ADJUSTABLE_BATTERY_LED_BRIGHTNESS (adjustable battery brightness)
         
         RGB Notification + RGB Battery + Pulsating + Battery LED + Adjustable Brightness
         = 1 + 2 + 8 + 32 + 64 + 128 = 235 -->
    
    <integer name="config_deviceLightCapabilities">235</integer>


    <!-- ╔══════════════════════════════════════════════════════════╗
         ║  НАВИГАЦИЯ И КНОПКИ                                      ║
         ╚══════════════════════════════════════════════════════════╝ -->

    <!-- Аппаратные кнопки на устройстве (битовое поле):
         1 = Home
         2 = Back  
         4 = Menu
         8 = Assistant
         16 = App Switch
         32 = Camera
         64 = Volume Rocker
         
         X00TD/X01BD: только качелька громкости = 64 -->
    <integer name="config_deviceHardwareKeys">64</integer>

    <!-- Какие кнопки могут будить устройство -->
    <integer name="config_deviceHardwareWakeKeys">64</integer>

    <!-- Действия экранных кнопок навигации -->
    
    <!-- Долгое нажатие Back: 0=ничего, 10=kill app -->
    <integer name="config_longPressOnBackBehavior">0</integer>
    
    <!-- Двойное нажатие Back -->
    <integer name="config_doubleTapOnBackBehavior">0</integer>
    
    <!-- Долгое нажатие Home: 3=Assistant -->
    <integer name="config_longPressOnHomeBehavior">3</integer>
    
    <!-- Двойное нажатие Home: 8=Last app -->
    <integer name="config_doubleTapOnHomeBehavior">8</integer>
    
    <!-- Долгое нажатие Menu (если есть): 2=Recent apps -->
    <integer name="config_longPressOnMenuBehavior">2</integer>
    <integer name="config_doubleTapOnMenuBehavior">0</integer>
    
    <!-- Долгое нажатие Recent: 9=Split screen -->
    <integer name="config_longPressOnAppSwitchBehavior">9</integer>
    
    <!-- Двойное нажатие Recent: 8=Last app -->
    <integer name="config_doubleTapOnAppSwitchBehavior">8</integer>

    <!-- Timeout для kill app через долгое нажатие Back -->
    <integer name="config_backKillTimeout">1500</integer>

    <!-- Подсветка кнопок (нет физических кнопок навигации) -->
    <integer name="config_deviceSupportsButtonBrightnessControl">0</integer>
    <dimen name="config_buttonBrightnessSettingDefaultFloat">0.0</dimen>
    
    <integer name="config_deviceSupportsKeyboardBrightnessControl">0</integer>
    <dimen name="config_keyboardBrightnessSettingDefaultFloat">0.0</dimen>


    <!-- ╔══════════════════════════════════════════════════════════╗
         ║  ADVANCED REBOOT                                         ║
         ╚══════════════════════════════════════════════════════════╝ -->

    <string-array name="config_restartActionsList">
        <item>restart</item>
        <item>restart_recovery</item>
        <item>restart_bootloader</item>
        <item>restart_systemui</item>
    </string-array>


    <!-- ╔══════════════════════════════════════════════════════════╗
         ║  ЗАРЯДКА                                                 ║
         ╚══════════════════════════════════════════════════════════╝ -->

    <!-- Charging Control (PM660 поддерживает) -->
    <bool name="config_chargingControlEnabled">true</bool>
    <integer name="config_defaultChargingControlMode">1</integer>
    <integer name="config_defaultChargingControlLimit">95</integer>
    <integer name="config_defaultChargingControlStartTime">79200</integer>
    <integer name="config_defaultChargingControlTargetTime">21600</integer>
    <integer name="config_chargingControlTimeMargin">30</integer>
    <integer name="config_chargingControlBatteryRechargeMargin">5</integer>

    <!-- Беспроводная зарядка (нет) -->
    <bool name="config_deviceSupportsWirelessCharging">false</bool>


    <!-- ╔══════════════════════════════════════════════════════════╗
         ║  СКАНЕР ОТПЕЧАТКОВ (LINEAGE SDK)                         ║
         ╚══════════════════════════════════════════════════════════╝ -->

    <!-- ═══════════ WAKE AND UNLOCK ═══════════ -->

    <!-- Разбудить и разблокировать касанием сканера 
         (критично для заднего сканера!) -->
    <bool name="config_fingerprintWakeAndUnlock">true</bool>

    <!-- ═══════════ ОЧИСТКА НЕИСПОЛЬЗУЕМЫХ ОТПЕЧАТКОВ ═══════════ -->

    <!-- Удалять отпечатки при переключении пользователя 
         или подключении к демону -->
    <bool name="config_cleanupUnusedFingerprints">false</bool>

    <!-- ═══════════ СОВМЕСТИМОСТЬ СО СТАРЫМИ HAL ═══════════ -->

    <!-- Для некоторых старых vendor HAL нужно уведомлять 
         об успешной отмене аутентификации -->
    <bool name="config_fingerprintPostResetRunnableForAllClients">false</bool>


    <!-- ╔══════════════════════════════════════════════════════════╗
         ║  КАМЕРА                                                  ║
         ╚══════════════════════════════════════════════════════════╝ -->

    <!-- Разрешённые приложения для aux камер (GCam и т.д.) -->
    <string-array name="config_cameraAuxPackageAllowList" translatable="false">
        <item>org.codeaurora.snapcam</item>
        <item>com.android.MGC</item>
        <item>com.android.camera</item>
        <item>com.android.camera2</item>
        <item>org.lineageos.aperture</item>
        <item>org.lineageos.aperture.dev</item>
        <item>com.google.android.GoogleCamera</item>
        <item>com.google.android.GoogleCamera.Cameight</item>
        <item>com.google.android.GoogleCameraGo</item>
        <item>com.google.android.GoogleCameraEng</item>
    </string-array>
    
    <!-- The list of package IDs that are not allowed to use aux cameras. -->
    <string-array name="config_cameraAuxPackageExcludeList" translatable="false">
        <item>org.telegram.messenger</item>
        <item>com.microsoft.teams</item>
        <item>com.discord</item>
	    <item>org.thunderdog.challegram</item>
        <item>us.zoom.videomeetings</item>
    </string-array> 


    <!-- ╔══════════════════════════════════════════════════════════╗
         ║  РАЗНОЕ                                                  ║
         ╚══════════════════════════════════════════════════════════╝ -->

    <!-- Высокий aspect ratio (18:9) -->
    <bool name="config_haveHigherAspectRatioScreen">true</bool>

    <!-- Устаревшее шифрование (нет) -->
    <bool name="config_trustLegacyEncryption">false</bool>

</resources>
