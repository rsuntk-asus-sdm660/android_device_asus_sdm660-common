# ═══════════════════════════════════════════════════════════════
# Domain for ZRAM and VM configuration scripts
# ═══════════════════════════════════════════════════════════════

type zram_config, domain;
type zram_config_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(zram_config)

# ═══════════════════════════════════════════════════════════════
# CAPABILITIES (для swapon/swapoff)
# ═══════════════════════════════════════════════════════════════

allow zram_config self:capability { sys_admin };

# ═══════════════════════════════════════════════════════════════
# SHELL EXECUTION
# ═══════════════════════════════════════════════════════════════

allow zram_config vendor_shell_exec:file rx_file_perms;
allow zram_config vendor_toolbox_exec:file rx_file_perms;

# AWK execution (denied in your logs)
allow zram_config vendor_file:file { execute execute_no_trans read open getattr };

# ═══════════════════════════════════════════════════════════════
# ZRAM DEVICE
# ═══════════════════════════════════════════════════════════════

allow zram_config sysfs_zram:dir r_dir_perms;
allow zram_config sysfs_zram:file rw_file_perms;
allow zram_config block_device:dir search;
allow zram_config swap_block_device:blk_file { getattr read write open ioctl };

# ═══════════════════════════════════════════════════════════════
# VM TUNING (/proc/sys/vm/*)
# ═══════════════════════════════════════════════════════════════

allow zram_config proc:file rw_file_perms;
allow zram_config proc_meminfo:file r_file_perms;

allow zram_config proc_page_cluster:file rw_file_perms;
allow zram_config proc_watermark_boost_factor:file rw_file_perms;
allow zram_config proc_watermark_scale_factor:file rw_file_perms;

# ДОБАВЛЕНО: denied в логах
allow zram_config proc_extra_free_kbytes:file rw_file_perms;
allow zram_config proc_dirty:file rw_file_perms;
allow zram_config proc_dirty_ratio:file rw_file_perms;

# ═══════════════════════════════════════════════════════════════
# PROPERTIES
# ═══════════════════════════════════════════════════════════════

set_prop(zram_config, vendor_zram_prop)

# ═══════════════════════════════════════════════════════════════
# LOGGING
# ═══════════════════════════════════════════════════════════════

allow zram_config kmsg_device:chr_file { open write };
