# Разрешить чтение симлинков (частая причина тихого отказа)
allow hal_vibrator_default sysfs_vibrator:lnk_file read;

# Разрешить поиск в папке (часто скрыто dontaudit)
allow hal_vibrator_default sysfs_vibrator:dir search;

# Разрешить запись в файлы управления
allow hal_vibrator_default sysfs_vibrator:file rw_file_perms;

allow hal_vibrator_default sysfs:file { write };
