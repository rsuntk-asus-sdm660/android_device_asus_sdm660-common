<resources>

    <!-- the padding on the start of the statusbar -->
    <dimen name="status_bar_padding_start">2dp</dimen>

    <!-- the padding on the end of the statusbar -->
    <dimen name="status_bar_padding_end">2dp</dimen>

    <!-- ═══════════ СКРУГЛЕНИЕ УВЕДОМЛЕНИЙ ═══════════ -->

    <!-- Радиус скругления уведомлений -->
    <dimen name="notification_corner_radius">16dp</dimen>
    <dimen name="notification_corner_radius_small">8dp</dimen>

    <!-- Скругление фона уведомлений -->
    <dimen name="notification_background_corner_radius">16dp</dimen>

    <!-- Скругление развёрнутых уведомлений -->
    <dimen name="notification_children_corner_radius">12dp</dimen>

    <!-- Скругление grouped уведомлений -->
    <dimen name="notification_group_corner_radius">16dp</dimen>

    <!-- ═══════════ СКРУГЛЕНИЕ ШТОРКИ ═══════════ -->

    <!-- Радиус скругления панели уведомлений -->
    <dimen name="notification_panel_corner_radius">16dp</dimen>

    <!-- Скругление Quick Settings -->
    <dimen name="qs_corner_radius">16dp</dimen>
    <dimen name="qs_panel_corner_radius">16dp</dimen>

    <!-- Скругление QS тайлов -->
    <dimen name="qs_tile_corner_radius">16dp</dimen>
    <dimen name="qs_tile_background_corner_radius">16dp</dimen>

    <!-- ═══════════ СКРУГЛЕНИЕ ДИАЛОГОВ ═══════════ -->

    <!-- Volume dialog -->
    <dimen name="volume_dialog_corner_radius">16dp</dimen>

    <!-- Power menu -->
    <dimen name="global_actions_corner_radius">16dp</dimen>

    <!-- ═══════════ ОБЩИЕ СКРУГЛЕНИЯ ═══════════ -->

    <!-- Rounded corners для окон -->
    <dimen name="rounded_corner_radius">8dp</dimen>
    <dimen name="rounded_corner_radius_top">8dp</dimen>
    <dimen name="rounded_corner_radius_bottom">8dp</dimen>

    <!-- Adjustment для скруглений -->
    <dimen name="rounded_corner_radius_adjustment">0dp</dimen>
    <dimen name="rounded_corner_radius_top_adjustment">0dp</dimen>
    <dimen name="rounded_corner_radius_bottom_adjustment">0dp</dimen>

</resources>
