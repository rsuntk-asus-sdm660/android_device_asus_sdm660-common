# Set NFC properties
get_prop(nfc, nfc_nq_prop)

allow nfc nfc_vendor_data_file:dir rw_dir_perms;
allow nfc nfc_vendor_data_file:file rw_file_perms;

allow nfc vendor_nfc_vendor_data_file:dir search;

# Allow nfc to set the ctl.start property for my_service
allow nfc ctl_start_prop:property_service set;

allow nfc nfc_vendor_data_file:file { create write open read setattr };
allow nfc nfc_vendor_data_file:dir { search add_name write };
