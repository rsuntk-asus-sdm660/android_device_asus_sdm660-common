allow hal_nfc_default nxpese_hwservice:hwservice_manager { add find };
allow hal_nfc_default nxpnfc_hwservice:hwservice_manager { add find };

allow hal_nfc_default vendor_nfc_vendor_data_file:dir rw_dir_perms;
allow hal_nfc_default vendor_nfc_vendor_data_file:file rw_file_perms;

# Allow the NFC HAL to access the NFC character device
allow hal_nfc_default nfc_device:chr_file { read write open ioctl };

allow hal_nfc_default nfc_device:chr_file rw_file_perms;
allow hal_nfc_default sysfs:file rw_file_perms;
allow hal_nfc_default sysfs_devices_system_cpu:file rw_file_perms;
