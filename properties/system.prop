# ART / Dex2oat
dalvik.vm.boot-dex2oat-cpu-set=0,1,2,3,4,5,6,7
dalvik.vm.boot-dex2oat-threads=8
dalvik.vm.dex2oat-cpu-set=0,1,2,3,4,5,6,7
dalvik.vm.dex2oat-filter=speed
dalvik.vm.dex2oat-threads=6
dalvik.vm.dex2oat64.enabled=true
dalvik.vm.image-dex2oat-cpu-set=0,1,2,3,4,5,6,7
dalvik.vm.image-dex2oat-filter=speed
dalvik.vm.image-dex2oat-threads=8
pm.dexopt.ab-ota=speed-profile

# Audio
af.fast_track_multiplier=1
audio.deep_buffer.media=true
audio.offload.min.duration.secs=30
audio.offload.video=true
audio.safemedia.bypass=true
audio.sys.noisy.broadcast.delay=600
audio.sys.offload.pstimeout.secs=3
persist.audio.jack.event=1
ro.audio.jack.detection=true
ro.config.alarm_vol_steps=25
ro.config.media_vol_steps=25
ro.config.vc_call_vol_steps=14

# Bluetooth
persist.bluetooth.a2dp_aac.vbr_supported=true
ro.bluetooth.remote.autopair=true
ro.bluetooth.request.master=true
vendor.bluetooth.soc=cherokee

# Charger
ro.charger.enable_suspend=true

# Display
sdm.debug.disable_skip_validate=1

# FM Radio
#vendor.hw.fm.init=0

# GPS
persist.vendor.overlay.izat.optin=rro

# SurfaceFlinger
debug.sf.disable_client_composition_cache=1
debug.sf.enable_hwc_vds=0
debug.sf.predict_hwc_composition_strategy=0
debug.sf.early.app.duration=13666666
debug.sf.early.sf.duration=15666666
debug.sf.earlyGl.app.duration=13666666
debug.sf.earlyGl.sf.duration=15666666
debug.sf.late.app.duration=13666666
debug.sf.late.sf.duration=15666666
debug.sf.use_phase_offsets_as_durations=1

# Blur
ro.launcher.blur.appLaunch=0

# Memory bandwidth optimization
persist.sys.use_16bpp_alpha=1

# Additional buffers shared between Camera and Video
vidc.enc.dcvs.extra-buff-count=2

# HWC
persist.demo.hdmirotationlock=false
persist.hwc.enable_vds=1
persist.hwc.mdpcomp.enable=true

# Scroll & Fling
ro.max.fling_velocity=20000
ro.min.fling_velocity=160

# GMS
ro.com.google.clientidbase.ms=android-asus-tpin
ro.com.google.rlz_ap_whitelist=y0,y5,y6,y7,y9
ro.com.google.rlzbrandcode=ASUP

# Telephony
DEVICE_PROVISIONED=1
persist.data.df.dev_name=rmnet_usb0
persist.dbg.ims_volte_enable=1
persist.dbg.volte_avail_ovr=1
persist.dbg.vt_avail_ovr=1
persist.dbg.wfc_avail_ovr=1
persist.radio.multisim.config=dsds
persist.radio.VT_CAM_INTERFACE=2
persist.sys.fflag.override.settings_network_and_internet_v2=true
ril.subscription.types=NV,RUIM
ro.com.android.dataroaming=false
ro.telephony.block_binder_thread_on_incoming_calls=false
ro.telephony.default_network=9,9
ro.telephony.iwlan_operation_mode=legacy
telephony.lteOnCdmaDevice=0

# Media
media.settings.xml=/vendor/etc/media_profiles_vendor.xml
media.stagefright.thumbnail.prefer_hw_codecs=true
vidc.enc.target_support_bframe=1

# Network
net.core.rmem_max=8388608
net.core.wmem_max=8388608
net.tcp.buffersize.default=4096,87380,110208,4096,16384,110208
net.tcp.buffersize.lte=2097152,4194304,8388608,262144,524288,1048576
net.tcp.buffersize.wifi=524288,1048576,2097152,262144,524288,1048576
net.tcp.default_init_rwnd=60
net.tethering.noprovisioning=true
persist.net.doxlat=true

# Netflix
ro.netflix.bsp_rev=Q660-13149-1

# NFC
ro.nfc.port=I2C

# NTP Server
persist.backup.ntpServer="0.pool.ntp.org"

# Performance
ro.sys.fw.bg_apps_limit=48

# RCS
persist.rcs.supported=1

# SSR
persist.vendor.ssr.restart_level=ALL_ENABLE

# FUSE
persist.sys.fuse.passthrough.enable=true

# Time
persist.timed.enable=true

# Zygote
zygote.critical_window.minute=10
