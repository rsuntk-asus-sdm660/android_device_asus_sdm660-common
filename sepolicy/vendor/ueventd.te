allow ueventd self:capability sys_nice;
allow ueventd metadata_file:dir search;
dontaudit ueventd mba_debug_dev:blk_file { read open };
allow ueventd ueventd:capability { kill };

# Разрешаем ueventd читать прошивки из vendor
allow ueventd vendor_firmware_file:dir r_dir_perms;
allow ueventd vendor_firmware_file:file r_file_perms;

allow ueventd firmware_file:dir { search read open getattr };
allow ueventd firmware_file:file { read open getattr };
