# Allow powerhal to read/write to dt2w node
allow hal_power_default proc_tpd_gesture:file rw_file_perms;
allow hal_power_default proc_tpd_gesture:dir r_dir_perms;

r_dir_file(hal_power_default, sysfs_graphics)
r_dir_file(hal_power_default, sysfs_input)
r_dir_file(hal_power_default, sysfs_sensor)

allow hal_power_default { sysfs_devfreq sysfs_kgsl }:dir search;
allow hal_power_default { sysfs_devfreq sysfs_kgsl }:{ file lnk_file } rw_file_perms;
allow hal_power_default sysfs_devices_system_cpu:file rw_file_perms;
allow hal_power_default sysfs_devices_system_cpu:dir r_dir_perms;
allow hal_power_default sysfs:file { read open getattr };
allow hal_power_default latency_device:chr_file rw_file_perms;

allow hal_power_default proc:file { write };

# To dump
allow hal_power_default cgroup:file read;

# Связь с Perf HAL через binder
allow hal_power_default hwservicemanager:binder { call transfer };
vndbinder_use(hal_power_default)

# Perf socket доступ
allow hal_power_default mpctl_socket:dir search;
allow hal_power_default mpctl_socket:sock_file { write getattr };

# Capability для boost
allow hal_power_default self:capability { sys_nice sys_admin };

# Прямой доступ к CPU (fallback)
allow hal_power_default sysfs_devices_system_cpu:lnk_file read;

hwbinder_use(hal_power_default)

# Разрешаем запись в ноды cpufreq и cpu_boost
allow hal_power_default sysfs_devices_system_cpu:file rw_file_perms;
allow hal_power_default sysfs:file rw_file_perms; # Если input_boost лежит в sysfs

# Разрешаем работу с cpuset cgroups
allow hal_power_default cgroup:dir r_dir_perms;
allow hal_power_default cgroup:file rw_file_perms;

set_prop(hal_power_default, vendor_power_prop)

# Разрешить Power HAL находить системную службу статистики (IStats)
allow hal_power_default fwk_stats_service:service_manager find;

# Делаем Power HAL легальным клиентом теплового сервиса (EAS Thermal Listener)
hal_client_domain(hal_power_default, hal_thermal)
