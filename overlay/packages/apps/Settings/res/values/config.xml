<?xml version="1.0" encoding="utf-8"?>
<!--
    ╔══════════════════════════════════════════════════════════════╗
    ║  SETTINGS CONFIG — ASUS X00TD / X01BD                        ║
    ║  Настройка приложения "Настройки"                            ║
    ╚══════════════════════════════════════════════════════════════╝
-->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- ╔══════════════════════════════════════════════════════════╗
         ║  ЭКРАН                                                   ║
         ╚══════════════════════════════════════════════════════════╝ -->

    <!-- Smooth Display (экран 60Hz) -->
    <bool name="config_show_smooth_display">true</bool>
    
    <!-- Включаем цветовую температуру -->
    <bool name="config_enableColorTemperature">true</bool>
    
    <!-- Night Light suggestion -->
    <bool name="config_night_light_suggestion_enabled">true</bool>

    <!-- List supported color modes. -->
    <integer-array name="config_availableColorModes">
        <item>0</item> <!-- COLOR_MODE_NATURAL -->
        <item>1</item> <!-- COLOR_MODE_BOOSTED -->
    </integer-array>

    <!-- ╔══════════════════════════════════════════════════════════╗
         ║  ЗВУК И ВИБРАЦИЯ                                         ║
         ╚══════════════════════════════════════════════════════════╝ -->

    <!-- Слайдер силы вибрации (2 уровня) -->
    <integer name="config_vibration_supported_intensity_levels">2</integer>

</resources>
