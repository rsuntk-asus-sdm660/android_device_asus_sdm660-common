cc_binary {
    name: "android.hardware.thermal-service.asus",
    vendor: true,
    relative_install_path: "hw",

    init_rc: ["android.hardware.thermal-service.asus.rc"],
    vintf_fragments: ["android.hardware.thermal-service.asus.xml"],

    srcs: [
        "main.cpp",
        "thermal.cpp",
        "thermalConfig.cpp",
        "thermalCommon.cpp",
        "thermalUtils.cpp",
        "thermalMonitor.cpp",
        "thermalCaps.cpp",
    ],

    shared_libs: [
        "libbase",
        "libcutils",
        "liblog",
        "libutils",
        "libbinder_ndk",
        "android.hardware.thermal-V2-ndk",
    ],

    cflags: [
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-DLOG_TAG=\"thermal_hal_asus\"",
    ],
}
