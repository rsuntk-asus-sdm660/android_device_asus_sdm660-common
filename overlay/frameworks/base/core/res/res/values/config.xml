    <bool name="config_allowAnimationsInLowPowerMode">false</bool>


    <!-- ═══════════════════════════════════════════════════════════════
         SECTION 3: MEMORY MANAGEMENT

         Universal for 3 GB / 4 GB / 6 GB + eMMC storage.

         PSI-based LMKD (kernel 4.19+):
           The kernel monitors memory pressure via PSI
           (/proc/pressure/memory) and makes kill decisions
           independently of legacy minfree tuning. The overlay
           only needs to set framework-level parameters.

         Scaling strategy:
           config_customizedMaxCachedProcesses = 32
             3 GB: tight — PSI will actively kill, 32 is a reasonable
                   upper bound that prevents thrashing
             4 GB: comfortable — most apps survive in cache
             6 GB: generous headroom — 32 is a soft floor,
                   ActivityManager may keep more if memory allows

           config_extraFreeKbytesAbsolute = 32768 (32 MB)
             Prevents direct reclaim stalls on eMMC which has
             3-5× worse random I/O than UFS. Critical for all
             RAM variants since the storage bottleneck is the same.

           Pinner: ~100 MB of critical framework files pinned
             3 GB: ~3.3% of RAM — acceptable
             4 GB: ~2.5% of RAM — comfortable
             6 GB: ~1.7% of RAM — negligible
             config_pinnerMaxPinnedMemoryPercentage = 8 caps it

           Task snapshots: 16-bit format, reduced resolution
             Saves ~30-50% snapshot memory vs 32-bit full-res.
             Visible quality difference is minimal on FHD+ panels.
         ═══════════════════════════════════════════════════════════════ -->

    <!-- LMK minfree: not used with PSI-based LMKD
         -1 = let LMKD handle everything via PSI pressure -->
    <integer name="config_lowMemoryKillerMinFreeKbytesAbsolute">-1</integer>
    <integer name="config_lowMemoryKillerMinFreeKbytesAdjust">0</integer>

    <!-- Extra free kbytes: 32 MB to prevent direct reclaim on eMMC
         This is independent of LMKD — controls /proc/sys/vm/extra_free_kbytes
         Same value works for 3/4/6 GB because the eMMC bottleneck
         is constant regardless of RAM amount -->
    <integer name="config_extraFreeKbytesAbsolute">32768</integer>
    <integer name="config_extraFreeKbytesAdjust">8192</integer>

    <!-- Task snapshots: save memory across all RAM variants -->
    <item name="config_highResTaskSnapshotScale" format="float" type="dimen">0.8</item>
    <item name="config_lowResTaskSnapshotScale" format="float" type="dimen">0.3</item>
    <bool name="config_use16BitTaskSnapshotPixelFormat">true</bool>
    <item name="config_resActivitySnapshotScale" format="float" type="dimen">0.5</item>
    <bool name="config_predictShowStartingSurface">true</bool>

    <!-- Max cached processes: 32
         See scaling strategy above — works across 3/4/6 GB -->
    <integer name="config_customizedMaxCachedProcesses">32</integer>

    <!-- Pinner Service: pin critical framework files
         Total ~100 MB — safe across all RAM variants
         (capped at 8% of total RAM by config_pinnerMaxPinnedMemoryPercentage) -->
    <string-array translatable="false" name="config_defaultPinnerServiceFiles">
        <item>/system/framework/framework.jar</item>
        <item>/system/framework/services.jar</item>
        <item>/apex/com.android.art/javalib/core-oj.jar</item>
        <item>/apex/com.android.art/javalib/core-libart.jar</item>
    </string-array>
    <integer name="config_pinnerHomePinBytes">31457280</integer>      <!-- 30 MB -->
    <integer name="config_pinnerCameraPinBytes">41943040</integer>    <!-- 40 MB -->
    <integer name="config_pinnerAssistantPinBytes">20971520</integer> <!-- 20 MB -->
    <integer name="config_pinnerWebviewPinBytes">10485760</integer>   <!-- 10 MB -->
    <integer name="config_pinnerMaxPinnedMemoryPercentage">8</integer>

    <!-- Recent apps limits -->
    <integer name="config_minNumVisibleRecentTasks_lowRam">5</integer>
    <integer name="config_maxNumVisibleRecentTasks_lowRam">6</integer>
    <integer name="config_minNumVisibleRecentTasks">5</integer>
    <integer name="config_maxNumVisibleRecentTasks">10</integer>

    <!-- Database: TRUNCATE journal + FULL sync — safe on eMMC
         Both devices use eMMC storage where MEMORY journal + OFF sync
         would risk data loss on crash. TRUNCATE + FULL is the safe
         and performant choice. -->
    <integer name="db_connection_pool_size">4</integer>
    <string name="db_default_journal_mode" translatable="false">TRUNCATE</string>
    <integer name="db_journal_size_limit">524288</integer>
    <integer name="db_wal_truncate_size">1048576</integer>
    <string name="db_default_sync_mode" translatable="false">FULL</string>
    <string name="db_wal_sync_mode" translatable="false">NORMAL</string>
    <integer name="db_wal_autocheckpoint">100</integer>
    <integer name="db_default_idle_connection_timeout">30000</integer>

    <!-- Zram writeback: extends effective RAM via swap to eMMC
         Beneficial across all RAM variants but especially for 3 GB -->
    <bool name="config_zramWriteback">true</bool>

    <!-- Downloads: conservative for 32/64 GB storage -->
    <integer name="config_downloadDataDirSize">100</integer>
    <integer name="config_MaxConcurrentDownloadsAllowed">3</integer>
    <integer name="config_downloadDataDirLowSpaceThreshold">15</integer>

    <!-- High-perf transitions: disabled
         SDM636 Adreno 509 and SDM660 Adreno 512 are both mid-range
         GPUs that struggle with high-perf transition effects -->
    <bool name="config_deviceSupportsHighPerfTransitions">false</bool>


