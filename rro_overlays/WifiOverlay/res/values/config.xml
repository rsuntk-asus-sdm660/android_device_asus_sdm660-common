<?xml version="1.0" encoding="utf-8"?>
<!-- 
    ASUS X00TD / X01BD — WiFi Overlay 
    Target: packages/modules/Wifi/res/values/config.xml
-->
<resources>
    <!-- 5GHz Hardware Support: DISABLED (Hardware limitation) -->
    <bool translatable="false" name="config_wifi5ghzSupport">false</bool>

    <!-- 802.11r Fast Transition: DISABLED (Stability fix for 2.4GHz) -->
    <bool translatable="false" name="config_wifi_fast_bss_transition_enabled">false</bool>

    <!-- Background Scanning: DISABLED (Battery saving) -->
    <bool translatable="false" name="config_wifi_background_scan_support">false</bool>

    <!-- Turn off WiFi during emergency calls: ENABLED (Interference reduction) -->
    <bool translatable="false" name="config_wifi_turn_off_during_emergency_call">true</bool>

    <!-- TCP Buffers: Optimized for SDM660 -->
    <string name="config_wifi_tcp_buffers" translatable="false">524288,2097152,8388608,262144,524288,4194304</string>

    <!-- SoftAP: ACS Supported, but NO 802.11ac (5GHz only) -->
    <bool translatable="false" name="config_wifi_softap_acs_supported">true</bool>
    <bool translatable="false" name="config_wifi_softap_ieee80211ac_supported">false</bool>

    <!-- MAC Randomization: ENABLED (Privacy) -->
    <bool name="config_wifi_connected_mac_randomization_supported">true</bool>
    <bool name="config_wifi_p2p_mac_randomization_supported">true</bool>
    <bool name="config_wifi_ap_mac_randomization_supported">true</bool>

    <!-- Link Probing: ENABLED (Better roaming) -->
    <bool name="config_wifi_link_probing_supported">true</bool>

    <!-- Diagnostics: DISABLED (User build) -->
    <bool translatable="false" name="config_wifi_diagnostics_bugreport_enabled">false</bool>

    <!-- SoftAP Max Clients: 16 (Realistic limit for 2.4GHz bandwidth) -->
    <integer translatable="false" name="config_wifiHardwareSoftapMaxClientCount">16</integer>

    <!-- SAR Power Limit: DISABLED (No SAR sensor support on X00TD) -->
    <bool translatable="false" name="config_wifi_framework_enable_sar_tx_power_limit">false</bool>
    
    <!-- WPA3 Upgrade: DISABLED (Hardware limitations) -->
    <bool translatable="false" name="config_wifiSaeUpgradeEnabled">false</bool>
    
    <!-- SAE H2E: DISABLED (Hardware limitations) -->
    <bool translatable="false" name="config_wifiSaeH2eSupported">false</bool>
</resources>
