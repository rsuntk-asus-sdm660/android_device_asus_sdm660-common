cc_binary {
    name: "android.hardware.biometrics.fingerprint-service.asus",
    init_rc: ["android.hardware.biometrics.fingerprint-service.asus.rc"],
    vintf_fragments: ["android.hardware.biometrics.fingerprint-service.asus.xml"],
    vendor: true,
    relative_install_path: "hw",
    srcs: [
        "BiometricsFingerprint.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "libhardware",
        "liblog",
        "libutils",
        "libhidlbase",
        "android.hardware.biometrics.fingerprint-V3-ndk",
        "android.hardware.biometrics.common-V3-ndk",
        "android.hardware.keymaster-V4-ndk",
    ],
    static_libs: [
        "libandroid.hardware.biometrics.fingerprint.VirtualProps",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
}
